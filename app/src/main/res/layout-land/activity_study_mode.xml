<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">
    <!-- 2. 전체 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/study_mode"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:layout_marginRight="10dp"
            android:background="@drawable/border_white"
            android:focusable="false"
            android:clickable="true"
            android:text="@string/default_all" /> <!-- 처음에 보여질 기본값 -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:background="@drawable/border_white"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:text="@string/home" />
    </LinearLayout>

    <!-- 3. 본문 컨테이너: 가로 정렬(Horizontal)로 좌/우 분할 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <!-- [왼쪽] 플래시 카드 박스 (가중치 1.2로 넓게 차지) -->
        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="@drawable/border_black"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">
            <!-- 단어 & 뜻 중앙 정렬 영역 (남은 공간을 모두 차지해 예문을 아래로 밀어냄) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- 단어 영역 -->
                <TextView
                    android:id="@+id/tvStudyWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="80dp"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#000000" />
                <!-- 발음 영역 -->

                <TextView
                    android:id="@+id/tvStudyPron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginBottom="10dp"
                    android:textColor="#000000"
                    android:textSize="17sp" />

                <!-- 뜻 영역 -->
                <TextView
                    android:id="@+id/tvStudyMean"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="18sp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#000000" />
            <!-- 예문 영역 (카드 박스 바닥에 바짝 붙음) -->
            <TextView
                android:id="@+id/tvStudyExam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="6dp"
                android:textColor="#555555"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- [오른쪽] 컨트롤 패널 (암기 완료 + 자동 넘김 설정) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_weight="0.8"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 암기 완료 체크박스 -->
            <CheckBox
                android:id="@+id/cbStudyCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/check"
                android:textColor="#000000"
                android:textSize="18sp" />

            <!-- 자동 넘김 설정 영역 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/flip_select"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/border_white"
                    android:textColor="@color/black"
                    android:text="-"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvIntervalStatus"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="2초"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/border_white"
                    android:textColor="@color/black"
                    android:text="+"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>