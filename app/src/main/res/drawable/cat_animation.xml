<?xml version="1.0" encoding="utf-8"?>
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    <!-- oneshot="false"는 애니메이션을 무한 반복하겠다는 의미입니다 -->

    <!-- 첫 번째 웃는 얼굴 (0.5초 동안 표시) -->
    <item android:drawable="@drawable/cat_smiling_1" android:duration="500" />

    <!-- 두 번째 눈 감고 웃는 얼굴 (0.5초 동안 표시) -->
    <item android:drawable="@drawable/cat_smiling_2" android:duration="500" />

</animation-list>